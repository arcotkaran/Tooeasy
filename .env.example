# ── Auth ──────────────────────────────────────────────────────────
# Generate with:  npx auth secret
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Authorised redirect URI:  https://YOUR-SITE.netlify.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Staff allowlists (comma-separated emails) ─────────────────────
# Anyone signing in with one of these Google accounts gets that role.
ADMIN_EMAILS=
DRIVER_EMAILS=
MECHANIC_EMAILS=

# ── Database ──────────────────────────────────────────────────────
# Nothing to set. Netlify provisions Postgres automatically and
# @netlify/database picks up the connection string on its own.
